# Copy to .env (gitignored) and fill in ONE key. `uv run demo secret check` shows what is picked up.
# Direct to Anthropic (claude-opus-5-5):
ANTHROPIC_API_KEY=
# Or through OpenRouter (anthropic/claude-opus-5.5):
OPENROUTER_API_KEY=
# Optional: force a provider when both are set (anthropic | openrouter).
# COMPASS_LLM_PROVIDER=anthropic
